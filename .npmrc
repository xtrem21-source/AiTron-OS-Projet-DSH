# Workspace local configuration - keeps every package cache off drive C:.
# The pnpm content-addressable store, the metadata cache and the state files all
# live under K:\Reasonix-Temp-2 (see K:\Reasonix-Temp-2\dsh-env.ps1 for the
# process environment that completes the redirection: TEMP/TMP, corepack,
# electron, node-gyp and Playwright caches).
store-dir=K:/Reasonix-Temp-2/pnpm-store
cache-dir=K:/Reasonix-Temp-2/pnpm-cache
state-dir=K:/Reasonix-Temp-2/pnpm-state
{
  "name": "@deepseek-ai/dsh-aionui-linear",
  "description": "Cache-stable linear prompt protocol for the AionUI shell: a static tail section plus a per-step audit of head injections",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
